generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity & Tenant ───────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  legalName String?  @map("legal_name")
  taxId     String?  @map("tax_id")
  phone     String?
  email     String?
  logoUrl   String?  @map("logo_url")
  settings  Json     @default("{}")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branches          Branch[]
  staff             Staff[]
  patients          Patient[]
  services          Service[]
  serviceCategories ServiceCategory[]
  appointments      Appointment[]
  invoices          Invoice[]
  paymentMethods    PaymentMethod[]
  files             File[]
  auditLogs         AuditLog[]
  activityLogs      ActivityLog[]
  notificationLogs  NotificationLog[]

  @@map("organizations")
}

model Branch {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  address        String?
  phone          String?
  email          String?
  timezone       String   @default("Europe/Moscow")
  workingHours   Json?    @map("working_hours")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization     Organization @relation(fields: [organizationId], references: [id])
  staff            Staff[]
  appointments     Appointment[]
  preferredBy      Patient[]    @relation("PreferredBranch")
  visits           Visit[]
  invoices         Invoice[]

  @@index([organizationId])
  @@map("branches")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  staff         Staff?
  auditLogs     AuditLog[]
  activityLogs  ActivityLog[]
  refreshTokens RefreshToken[]
  filesCreated  File[]         @relation("FileCreator")

  @@map("users")
}

model Staff {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @map("user_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  middleName     String?   @map("middle_name")
  specialization String?
  phone          String?
  avatarUrl      String?   @map("avatar_url")
  workingHours   Json?     @map("working_hours")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  staffRoles   StaffRole[]
  rolesAssigned StaffRole[] @relation("RoleAssigner")
  primaryPatients Patient[] @relation("PrimaryStaff")
  appointments Appointment[]
  visits       Visit[]
  treatmentPlans TreatmentPlan[]
  paymentsReceived Payment[] @relation("PaymentReceiver")
  refundsIssued Refund[] @relation("RefundIssuer")

  @@index([organizationId])
  @@index([branchId])
  @@map("staff")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  isSystem    Boolean @default(true) @map("is_system")

  staffRoles      StaffRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model StaffRole {
  id         String    @id @default(uuid()) @db.Uuid
  staffId    String    @map("staff_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  assignedBy String?   @map("assigned_by") @db.Uuid
  assignedAt DateTime  @default(now()) @map("assigned_at")
  revokedAt  DateTime? @map("revoked_at")

  staff    Staff  @relation(fields: [staffId], references: [id])
  role     Role   @relation(fields: [roleId], references: [id])
  assigner Staff? @relation("RoleAssigner", fields: [assignedBy], references: [id])

  @@unique([staffId, roleId])
  @@index([staffId])
  @@map("staff_roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique
  resource    String
  action      String
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Patients & Clinical ─────────────────────────────────────────

model Patient {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  preferredBranchId String?       @map("preferred_branch_id") @db.Uuid
  primaryStaffId    String?       @map("primary_staff_id") @db.Uuid
  firstName         String        @map("first_name")
  lastName          String        @map("last_name")
  middleName        String?       @map("middle_name")
  birthDate         DateTime?     @map("birth_date") @db.Date
  gender            Gender?
  phone             String
  email             String?
  address           String?
  emergencyContact  Json?         @map("emergency_contact")
  allergies         String?
  contraindications String?
  chronicDiseases   String?       @map("chronic_diseases")
  notes             String?
  source            PatientSource @default(OTHER)
  status            PatientStatus @default(ACTIVE)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")

  organization    Organization   @relation(fields: [organizationId], references: [id])
  preferredBranch Branch?        @relation("PreferredBranch", fields: [preferredBranchId], references: [id])
  primaryStaff    Staff?         @relation("PrimaryStaff", fields: [primaryStaffId], references: [id])
  medicalRecord   MedicalRecord?
  appointments    Appointment[]
  invoices        Invoice[]

  @@index([organizationId])
  @@index([organizationId, lastName, firstName])
  @@index([organizationId, phone])
  @@map("patients")
}

model MedicalRecord {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  patientId      String   @unique @map("patient_id") @db.Uuid
  summary        String?
  openedAt       DateTime @default(now()) @map("opened_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedBy      String?  @map("updated_by") @db.Uuid

  patient        Patient         @relation(fields: [patientId], references: [id])
  visits         Visit[]
  treatmentPlans TreatmentPlan[]
  attachments    Attachment[]

  @@index([organizationId])
  @@map("medical_records")
}

model Visit {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  medicalRecordId String      @map("medical_record_id") @db.Uuid
  appointmentId   String?     @unique @map("appointment_id") @db.Uuid
  staffId         String      @map("staff_id") @db.Uuid
  branchId        String      @map("branch_id") @db.Uuid
  visitedAt       DateTime    @map("visited_at")
  chiefComplaint  String?     @map("chief_complaint")
  anamnesis       String?
  clinicalNotes   String?     @map("clinical_notes")
  prescriptions   String?
  status          VisitStatus @default(PLANNED)
  createdAt       DateTime    @default(now()) @map("created_at")
  createdBy       String?     @map("created_by") @db.Uuid

  medicalRecord MedicalRecord  @relation(fields: [medicalRecordId], references: [id])
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  staff         Staff          @relation(fields: [staffId], references: [id])
  branch        Branch         @relation(fields: [branchId], references: [id])
  diagnoses     Diagnosis[]
  recommendations Recommendation[]
  measurements  Measurement[]
  attachments   Attachment[]

  @@index([organizationId])
  @@index([medicalRecordId])
  @@map("visits")
}

model Diagnosis {
  id          String   @id @default(uuid()) @db.Uuid
  visitId     String   @map("visit_id") @db.Uuid
  icdCode     String?  @map("icd_code")
  title       String
  description String?
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String?  @map("created_by") @db.Uuid

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@map("diagnoses")
}

model TreatmentPlan {
  id              String              @id @default(uuid()) @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  medicalRecordId String              @map("medical_record_id") @db.Uuid
  staffId         String              @map("staff_id") @db.Uuid
  title           String
  description     String?
  startDate       DateTime?           @map("start_date") @db.Date
  endDate         DateTime?           @map("end_date") @db.Date
  status          TreatmentPlanStatus @default(DRAFT)
  createdAt       DateTime            @default(now()) @map("created_at")
  createdBy       String?             @map("created_by") @db.Uuid

  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  staff         Staff         @relation(fields: [staffId], references: [id])

  @@index([medicalRecordId])
  @@map("treatment_plans")
}

model Recommendation {
  id           String    @id @default(uuid()) @db.Uuid
  visitId      String    @map("visit_id") @db.Uuid
  content      String
  followUpDate DateTime? @map("follow_up_date") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by") @db.Uuid

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@map("recommendations")
}

model Measurement {
  id          String   @id @default(uuid()) @db.Uuid
  visitId     String   @map("visit_id") @db.Uuid
  type        String
  unit        String?
  value       Decimal  @db.Decimal(10, 2)
  notes       String?
  measuredAt  DateTime @map("measured_at")
  measuredBy  String?  @map("measured_by") @db.Uuid

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@map("measurements")
}

model Attachment {
  id              String       @id @default(uuid()) @db.Uuid
  visitId         String?      @map("visit_id") @db.Uuid
  medicalRecordId String?      @map("medical_record_id") @db.Uuid
  fileId          String       @unique @map("file_id") @db.Uuid
  documentType    DocumentType @map("document_type")
  title           String?
  description     String?
  createdAt       DateTime     @default(now()) @map("created_at")

  visit         Visit?         @relation(fields: [visitId], references: [id])
  medicalRecord MedicalRecord? @relation(fields: [medicalRecordId], references: [id])
  file          File           @relation(fields: [fileId], references: [id])

  @@map("attachments")
}

// ─── Services & Appointments ─────────────────────────────────────

model ServiceCategory {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  slug           String
  sortOrder      Int     @default(0) @map("sort_order")
  isActive       Boolean @default(true) @map("is_active")

  organization Organization @relation(fields: [organizationId], references: [id])
  services     Service[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("service_categories")
}

model Service {
  id              String  @id @default(uuid()) @db.Uuid
  organizationId  String  @map("organization_id") @db.Uuid
  categoryId      String? @map("category_id") @db.Uuid
  name            String
  description     String?
  durationMinutes Int     @map("duration_minutes")
  price           Decimal @db.Decimal(12, 2)
  isHidden        Boolean @default(false) @map("is_hidden")
  isActive        Boolean @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id])
  category     ServiceCategory? @relation(fields: [categoryId], references: [id])
  appointments Appointment[]
  invoiceItems InvoiceItem[]

  @@index([organizationId])
  @@map("services")
}

model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  branchId       String            @map("branch_id") @db.Uuid
  patientId      String            @map("patient_id") @db.Uuid
  staffId        String            @map("staff_id") @db.Uuid
  serviceId      String            @map("service_id") @db.Uuid
  startsAt       DateTime          @map("starts_at")
  endsAt         DateTime          @map("ends_at")
  durationMinutes Int              @map("duration_minutes")
  basePrice      Decimal           @map("base_price") @db.Decimal(12, 2)
  discountType   DiscountType      @default(NONE) @map("discount_type")
  discountValue  Decimal           @default(0) @map("discount_value") @db.Decimal(12, 2)
  discountAmount Decimal           @default(0) @map("discount_amount") @db.Decimal(12, 2)
  finalPrice     Decimal           @map("final_price") @db.Decimal(12, 2)
  status         AppointmentStatus @default(CREATED)
  notes          String?
  createdAt      DateTime          @default(now()) @map("created_at")
  createdBy      String?           @map("created_by") @db.Uuid
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  organization  Organization               @relation(fields: [organizationId], references: [id])
  branch        Branch                     @relation(fields: [branchId], references: [id])
  patient       Patient                    @relation(fields: [patientId], references: [id])
  staff         Staff                      @relation(fields: [staffId], references: [id])
  service       Service                    @relation(fields: [serviceId], references: [id])
  statusHistory AppointmentStatusHistory[]
  visit         Visit?
  invoice       Invoice?

  @@index([organizationId, staffId, startsAt])
  @@index([organizationId, branchId, startsAt])
  @@index([organizationId, patientId, startsAt])
  @@map("appointments")
}

model AppointmentStatusHistory {
  id            String            @id @default(uuid()) @db.Uuid
  appointmentId String            @map("appointment_id") @db.Uuid
  fromStatus    AppointmentStatus? @map("from_status")
  toStatus      AppointmentStatus @map("to_status")
  reason        String?
  metadata      Json?
  changedAt     DateTime          @default(now()) @map("changed_at")
  changedBy     String?           @map("changed_by") @db.Uuid

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("appointment_status_history")
}

// ─── Finance ─────────────────────────────────────────────────────

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  branchId       String        @map("branch_id") @db.Uuid
  patientId      String        @map("patient_id") @db.Uuid
  appointmentId  String?       @unique @map("appointment_id") @db.Uuid
  number         String
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount    Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  balance        Decimal       @default(0) @db.Decimal(12, 2)
  notes          String?
  issuedAt       DateTime?     @map("issued_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  createdBy      String?       @map("created_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  appointment  Appointment? @relation(fields: [appointmentId], references: [id])
  items        InvoiceItem[]
  payments     Payment[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@map("invoices")
}

model InvoiceItem {
  id             String       @id @default(uuid()) @db.Uuid
  invoiceId      String       @map("invoice_id") @db.Uuid
  serviceId      String?      @map("service_id") @db.Uuid
  description    String
  quantity       Int          @default(1)
  unitPrice      Decimal      @map("unit_price") @db.Decimal(12, 2)
  discountType   DiscountType @default(NONE) @map("discount_type")
  discountValue  Decimal      @default(0) @map("discount_value") @db.Decimal(12, 2)
  discountAmount Decimal      @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalPrice     Decimal      @map("total_price") @db.Decimal(12, 2)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id])

  @@index([invoiceId])
  @@map("invoice_items")
}

model PaymentMethod {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  code           String
  name           String
  type           PaymentMethodType
  isActive       Boolean           @default(true) @map("is_active")
  config         Json              @default("{}")

  organization Organization @relation(fields: [organizationId], references: [id])
  payments     Payment[]

  @@unique([organizationId, code])
  @@map("payment_methods")
}

model Payment {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  invoiceId       String   @map("invoice_id") @db.Uuid
  paymentMethodId String   @map("payment_method_id") @db.Uuid
  amount          Decimal  @db.Decimal(12, 2)
  reference       String?
  notes           String?
  paidAt          DateTime @map("paid_at")
  receivedBy      String?  @map("received_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  invoice       Invoice       @relation(fields: [invoiceId], references: [id])
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  receiver      Staff?        @relation("PaymentReceiver", fields: [receivedBy], references: [id])
  refunds       Refund[]

  @@index([invoiceId])
  @@map("payments")
}

model Refund {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  paymentId      String   @map("payment_id") @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  reason         String?
  refundedAt     DateTime @map("refunded_at")
  refundedBy     String?  @map("refunded_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  payment  Payment @relation(fields: [paymentId], references: [id])
  issuer   Staff?  @relation("RefundIssuer", fields: [refundedBy], references: [id])

  @@index([paymentId])
  @@map("refunds")
}

// ─── Files ───────────────────────────────────────────────────────

model File {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  entityType      String          @map("entity_type")
  entityId        String          @map("entity_id") @db.Uuid
  filename        String
  mimeType        String          @map("mime_type")
  size            BigInt
  storageProvider StorageProvider @map("storage_provider")
  storageKey      String          @map("storage_key")
  externalId      String?         @map("external_id")
  checksum        String?
  createdBy       String          @map("created_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")
  deletedAt       DateTime?       @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  creator      User         @relation("FileCreator", fields: [createdBy], references: [id])
  attachment   Attachment?

  @@index([organizationId, entityType, entityId])
  @@map("files")
}

// ─── Audit & Activity ────────────────────────────────────────────

model AuditLog {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  entityType     String      @map("entity_type")
  entityId       String      @map("entity_id") @db.Uuid
  fieldName      String?     @map("field_name")
  oldValue       String?     @map("old_value")
  newValue       String?     @map("new_value")
  action         AuditAction
  ipAddress      String?     @map("ip_address")
  createdAt      DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, userId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model ActivityLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  eventType      String   @map("event_type")
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  metadata       Json?
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

// ─── Notifications ───────────────────────────────────────────────

model NotificationTemplate {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  code           String
  channel        String
  subject        String?
  body           String
  isActive       Boolean @default(true) @map("is_active")

  @@unique([organizationId, code])
  @@map("notification_templates")
}

model NotificationLog {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  recipientId    String?            @map("recipient_id") @db.Uuid
  recipientType  String?            @map("recipient_type")
  channel        NotificationChannel
  templateCode   String?            @map("template_code")
  status         NotificationStatus @default(PENDING)
  payload        Json?
  errorMessage   String?            @map("error_message")
  scheduledAt    DateTime?          @map("scheduled_at")
  sentAt         DateTime?          @map("sent_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("notification_logs")
}

// ─── Enums ───────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PatientSource {
  REFERRAL
  WEBSITE
  SOCIAL
  WALK_IN
  ADVERTISING
  OTHER
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  COMPLETED
  ARCHIVED
}

enum VisitStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TreatmentPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DocumentType {
  PHOTO
  MRI
  CT
  XRAY
  LAB
  PDF
  DOC
  OTHER
}

enum DiscountType {
  NONE
  PERCENT
  FIXED
}

enum AppointmentStatus {
  CREATED
  CONFIRMED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum InvoiceStatus {
