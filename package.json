{
  "name": "integra",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "vercel-build": "bash infrastructure/scripts/vercel-build-web.sh",
    "db:generate": "pnpm --filter @integra/api db:generate",
    "db:migrate": "pnpm --filter @integra/api db:migrate",
    "db:push": "pnpm --filter @integra/api db:push",
    "db:seed": "pnpm --filter @integra/api db:seed",
    "db:studio": "pnpm --filter @integra/api db:studio",
    "db:timeweb": "node infrastructure/scripts/timeweb-setup.mjs",
    "db:backup": "node infrastructure/scripts/backup-to-gdrive.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
